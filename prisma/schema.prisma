generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String?
  role       String   @default("admin") // admin | employee | client
  phone      String?
  company    String?
  position   String?
  department String?
  avatar     String?
  hourlyRate Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  invoices       Invoice[] @relation("ClientInvoices")
  assignedTasks  Task[]      @relation("AssignedTasks")
  sentMessages   Message[]   @relation("SentMessages")
  timeEntries    TimeEntry[]
  shifts         Shift[]
  punches        Punch[]
  dailyNotes     DailyNote[]
  taskViews      TaskView[]
  chatMessages   ChatMessage[]
  chatRooms      ChatRoomMember[]
  workSessions   WorkSession[]
  orders         Order[]  @relation("ClientOrders")
  taskMemberships TaskMember[]
  clientWorkProjects WorkProject[]      @relation("ClientWorkProjects")
  workProjectMemberships WorkProjectMember[]
  timeOffRequests TimeOffRequest[] @relation("TimeOffRequester")
  reviewedTimeOff TimeOffRequest[] @relation("TimeOffReviewer")
  projectApprovals WorkProjectApproval[] @relation("ApprovalClient")
  auditLogs      AuditLog[] @relation("AuditActor")
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEs   String
  titleEn   String
  descEs    String   @db.Text
  descEn    String   @db.Text
  icon      String?
  image     String?
  gallery   String?  @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEs   String
  titleEn   String
  descEs    String   @db.Text
  descEn    String   @db.Text
  category  String?
  cover     String?
  images    String?  @db.Text
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  deadline  String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String    @id @default(cuid())
  number      String    @unique
  title       String
  description String?   @db.Text
  service     String?
  status      String    @default("new") // new | in_progress | completed | cancelled
  priority    String    @default("normal")
  total       Float     @default(0)
  paid        Float     @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  clientId    String
  client      User      @relation("ClientOrders", fields: [clientId], references: [id])
  workProjectId String?
  workProject   WorkProject? @relation(fields: [workProjectId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

model Task {
  id          String    @id @default(cuid())
  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  title       String
  description String?   @db.Text
  status      String    @default("todo") // todo | in_progress | done | blocked
  priority    String    @default("normal")
  hours       Float     @default(0)
  position    Float     @default(0) // ordering within a status column (Trello-style)
  coverImage  String?   // URL of the card's cover image (one of the attachments)
  // DEPRECATED – kept for backward compat during migration; use taskAttachments relation
  attachments String?   @db.Text
  // DEPRECATED – kept for backward compat during migration; use taskMembers relation
  members     String?   @db.Text
  archived    Boolean   @default(false)
  dueDate      DateTime?
  completedAt  DateTime?
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  workProjectId String?
  workProject   WorkProject? @relation(fields: [workProjectId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  timeEntries     TimeEntry[]
  comments        TaskComment[]
  activities      TaskActivity[]
  views           TaskView[]
  workSessions    WorkSession[]
  approvalSheet   ApprovalSheet?
  taskMembers     TaskMember[]
  taskAttachments TaskAttachment[]
  checklistItems  TaskChecklistItem[]

  @@index([status, position])
  @@index([orderId])
  @@index([workProjectId])
  @@index([archived])
}

// Proper relational members (replaces Task.members JSON field)
model TaskMember {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

// Proper relational attachments (replaces Task.attachments JSON field)
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String
  name      String?
  mimeType  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId, position])
}

// Checklist items inside a task
model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

model ApprovalSheet {
  id          String   @id @default(cuid())
  taskId      String   @unique
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // JSON: { numero, cliente, fecha, material, terminacion, nota, pages: [{ id, images: [{ id, url, x, y, scale }] }] }
  data        String   @db.Text
  // pending | approved | changes_requested
  status      String   @default("pending")
  clientNote  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  body        String   @db.Text
  // JSON array of attachment objects: [{ url, name, type, kind }]
  attachments String?  @db.Text
  // JSON array of mentioned user ids.
  mentions    String?  @db.Text
  editedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, createdAt])
}

model TaskView {
  id     String   @id @default(cuid())
  taskId String
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String?  // snapshot of user name
  avatar String?  // snapshot of avatar
  seenAt DateTime @updatedAt

  @@unique([taskId, userId])
  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  // e.g. "status_changed", "priority_changed", "assigned", "members_added",
  // "members_removed", "title_changed", "due_changed", "attachment_added",
  // "cover_set", "created"
  type      String
  // Optional structured payload as JSON: { from, to, ids, ... }
  data      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// Editable Trello-style columns/lists for the task board. Rows here drive the
// column set rendered on /admin/tareas. If the table is empty the server falls
// back to the four built-in defaults (todo / in_progress / blocked / done).
model TaskColumn {
  id        String   @id @default(cuid())
  key       String   @unique // status value stored on Task.status
  label     String
  accent    String?  // tailwind class e.g. "bg-amber-500"
  position  Float    @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours     Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// Tracks a live work session started by an employee on a specific task.
// endedAt = null means the session is currently active.
model WorkSession {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([taskId])
  @@index([userId, endedAt])
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  // Optional link to a registered client user
  clientId      String?
  client        User?     @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: SetNull)
  // Direct client info (filled when no user account)
  clientName    String?
  clientEmail   String?
  clientCompany String?
  clientPhone   String?
  amount        Float
  paid          Float     @default(0)
  status        String    @default("pending") // pending | paid | overdue | cancelled
  issuedAt      DateTime  @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
}

// ── Internal chat ──────────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  type      String   @default("general") // general | direct
  name      String?
  createdAt DateTime @default(now())

  members  ChatRoomMember[]
  messages ChatMessage[]
}

model ChatRoomMember {
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String    @id @default(cuid())
  roomId      String
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String?   @db.Text
  type        String    @default("text") // text | file | voice
  attachments String?   @db.Text // JSON: [{ url, name, type, kind, size }]
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  @@index([roomId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  toRole    String?  // "client" | "admin" | "employee"
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Weekly recurring schedule for an employee.
// dayOfWeek: 0=Sun .. 6=Sat. start/end stored as "HH:mm" strings (local PR time).
model Shift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0..6
  start     String   // "HH:mm"
  end       String   // "HH:mm"
  label     String?  // e.g. "Turno regular", "Cierre"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayOfWeek])
}

// Punch in / punch out events. A punch-in row is created on clock-in and
// updated with `out` time on clock-out.
model Punch {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  in        DateTime     @default(now())
  out       DateTime?
  hours     Float?       // computed on clock-out (net of breaks)
  note      String?
  source    String       @default("manual") // manual | auto | admin
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  breaks    PunchBreak[]

  @@index([userId, in])
}

model PunchBreak {
  id        String    @id @default(cuid())
  punchId   String
  punch     Punch     @relation(fields: [punchId], references: [id], onDelete: Cascade)
  start     DateTime  @default(now())
  end       DateTime?
  createdAt DateTime  @default(now())

  @@index([punchId])
}

model DailyNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // store as start-of-day UTC
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// Global site settings stored as key-value pairs.
// Keys are unique strings; values are plain text (JSON-encoded for complex types).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ── Etapa 0: Fundación (datos base de contabilidad de costos) ────────────────

// Catálogo de materiales con su costo por pie². Es la base del motor de
// precios/costos (Etapa 3). Ej.: D-Board 3mm, PVC 1/8", Acrílico, Banner, Vinil.
model Material {
  id         String   @id @default(cuid())
  name       String // ej. "D-Board"
  category   String // ej. "d-board" | "pvc" | "acrilico" | "banner" | "vinil" | "mesh" | "microperforado" | "static-cling"
  thickness  String? // ej. "3mm", "1/8\"", "1\""
  costPerSqFt Float  @default(0) // costo por pie²
  unit       String   @default("ft2")
  notes      String?  @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

// Costo de hora-hombre por cada rol del taller. Alimenta el cálculo del costo
// real por proyecto (horas-hombre).
model RoleRate {
  id         String   @id @default(cuid())
  role       String   @unique // ej. "Artista Gráfico", "Rotulista", "Wrapper"
  hourlyCost Float    @default(0) // costo por hora-hombre
  notes      String?  @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Capacidad real del taller por proceso/máquina (ej. 300 planchas de D-Board
// 3mm al día). Limita las promesas de venta a la capacidad real (Etapa 6).
model ShopCapacity {
  id          String   @id @default(cuid())
  process     String // ej. "Impresión D-Board 3mm"
  unitsPerDay Int      @default(0)
  unitLabel   String   @default("unidades") // ej. "planchas", "pies²"
  notes       String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Etapa 1: Núcleo de Proyectos ─────────────────────────────────────────────

// El Proyecto es el centro de toda la operación. Nace de un estimado y toma su
// número de él. De aquí cuelgan horas, materiales, fotos, hojas y pagos.
// (Se llama WorkProject para no chocar con el modelo Project del portafolio.)
model WorkProject {
  id             String   @id @default(cuid())
  number         String   @unique // número de proyecto (= número del estimado)
  estimateNumber String? // número del estimado de origen
  title          String
  description    String?  @db.Text
  // Etapa actual del tablero (key de ProjectStage). Fallback a "intake".
  stage          String   @default("intake")
  priority       String   @default("normal") // low | normal | high | urgent
  // Tipo de trabajo: sin instalación (impreso) o con instalación. Define la mezcla 70/30.
  installationType String @default("no_install") // no_install | with_install
  clientId       String?
  client         User?    @relation("ClientWorkProjects", fields: [clientId], references: [id], onDelete: SetNull)
  // Snapshot de datos del cliente cuando no hay cuenta registrada.
  clientName     String?
  clientEmail    String?
  clientPhone    String?
  quoted         Float    @default(0) // monto facturado/cotizado
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members     WorkProjectMember[]
  documents   WorkProjectDocument[]
  stageEvents WorkProjectStageEvent[]
  orders      Order[]
  tasks       Task[]
  techSheet   WorkProjectTechSheet?
  approvals   WorkProjectApproval[]

  @@index([stage])
  @@index([clientId])
  @@index([archived])
}

// Etapas editables del tablero de proyectos (estilo TaskColumn). Si la tabla
// está vacía, el servidor usa las etapas por defecto del flujo del taller.
model ProjectStage {
  id        String   @id @default(cuid())
  key       String   @unique // valor guardado en WorkProject.stage
  label     String
  accent    String? // clase tailwind, ej. "bg-amber-500"
  position  Float    @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// Responsables asignados a un proyecto.
model WorkProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel String? // rol en el proyecto, ej. "PM", "Artista Gráfico"
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Documentos / hojas del expediente del proyecto (estimado, factura,
// confirmación de pago, hoja de aprobación, site inspection, entrega, etc.).
model WorkProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // estimate | invoice | payment | approval | site_inspection |
  // delivery_shop | delivery_final | vehicle_review | tech_sheet | other
  type      String   @default("other")
  name      String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// Registro de cada cambio de etapa con su evidencia (regla de oro: ninguna
// etapa avanza sin foto + checklist).
model WorkProjectStageEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String
  fromStage  String?
  toStage    String
  note       String?  @db.Text
  // JSON array de URLs de fotos de evidencia.
  photos     String?  @db.Text
  // JSON array de items de checklist: [{ text, done }]
  checklist  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

// ── Etapa 2: Solicitud y aprobación de días libres ───────────────────────────

// Solicitud de días libres de un colaborador, aprobada o denegada por el PM.
model TimeOffRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("TimeOffRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime  // día inicial (inclusive)
  endDate     DateTime  // día final (inclusive)
  type        String    @default("vacation") // vacation | sick | personal | unpaid | other
  reason      String?   @db.Text
  status      String    @default("pending") // pending | approved | denied | cancelled
  reviewerId  String?
  reviewer    User?     @relation("TimeOffReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote  String?   @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, startDate])
}

// ── Etapa 3: Motor de costos y precios ───────────────────────────────────────

// Ficha técnica de cierre de producción. Guarda lo necesario para repetir el
// trabajo igual y congela el costo real calculado al cerrar el proyecto.
model WorkProjectTechSheet {
  id           String      @id @default(cuid())
  projectId    String      @unique
  project      WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Datos de producción para repetir el trabajo.
  materialName String?
  printType    String? // tipo de impresión
  rip          String?
  machine      String?
  materialQty  Float? // cantidad de material (pies²)
  notes        String?     @db.Text
  // Costos congelados al cierre.
  materialCost Float       @default(0)
  inkCost      Float       @default(0)
  laborCost    Float       @default(0)
  otherCost    Float       @default(0)
  totalCost    Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ── Etapa 4: Portal del cliente — aprobaciones ───────────────────────────────

// Solicitud de aprobación enviada al cliente (diseño/arte o cotización). El
// cliente aprueba o pide cambios desde su portal.
model WorkProjectApproval {
  id          String      @id @default(cuid())
  projectId   String
  project     WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      User?       @relation("ApprovalClient", fields: [clientId], references: [id], onDelete: SetNull)
  type        String      @default("design") // design | quote
  title       String
  description String?     @db.Text
  // JSON array de URLs (arte/cotización a revisar).
  files       String?     @db.Text
  status      String      @default("pending") // pending | approved | changes
  clientNote  String?     @db.Text
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([clientId, status])
}

// ── Tienda de productos (Store) ──────────────────────────────────────────────

// Productos que se muestran en la página pública /tienda. Las variantes y las
// imágenes se guardan como JSON para mantener la estructura flexible.
model StoreProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text // HTML o texto plano
  category    String?  // ej. "Stickers", "Banners", "D-Boards"
  image       String?  // URL imagen principal
  images      String?  @db.Text // JSON: string[]
  // JSON: [{ id, title, option1, option2, price, compareAtPrice, available }]
  variants    String?  @db.Text
  priceFrom   Float    @default(0) // precio mínimo para mostrar "Desde $X"
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

// ── Endurecimiento de seguridad: registro de auditoría ───────────────────────

// Bitácora de acciones sensibles (crear/editar/borrar) realizadas por usuarios
// admin/empleado. Permite rastrear quién cambió qué y cuándo.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // snapshot por si se borra el usuario
  actorRole  String? // admin | employee | client
  action     String // ej. "create" | "update" | "delete" | "login" | "export"
  entity     String // ej. "WorkProject" | "Invoice" | "Material" | "User"
  entityId   String? // id del registro afectado
  summary    String?  @db.Text // descripción legible, ej. "Cambió etapa a producción"
  metadata   String?  @db.Text // JSON con datos extra
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
